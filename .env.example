# Copy this file to .env and fill in your keys before running the pipeline.
# Local/LM Studio models do not require an API key.

OPENAI_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here

# Optional: override the local OpenAI-compatible model server
LOCAL_MODEL_ID=your_local_model_id
LOCAL_MODEL_BASE_URL=http://127.0.0.1:1234/v1
